<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: drive the engine from adb, e.g.
     adb shell am broadcast -a io.github.feg55.zarp.DEBUG -n io.github.feg55.zarp/.DebugCommandReceiver -\-es cmd "test warp-q-google6"
     Commands: quick | full | connect | disconnect | cancel | test <id,id,...> | use <id> -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".DebugCommandReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="io.github.feg55.zarp.DEBUG" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
